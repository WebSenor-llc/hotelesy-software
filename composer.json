{
    "name": "websenor/hotelesy",
    "type": "project",
    "description": "Hotelesy by WebSenor — Multi-tenant Hotel Management Platform (PMS, POS, Channel Manager, Booking Engine)",
    "keywords": ["hotel", "pms", "saas", "laravel", "multi-tenant", "channel-manager"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^2.2",
        "guzzlehttp/guzzle": "^7.8",
        "inertiajs/inertia-laravel": "^1.0",
        "laravel/framework": "^11.0",
        "laravel/horizon": "^5.21",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "livewire/livewire": "^4.3",
        "predis/predis": "^2.2",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-multitenancy": "^4.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-query-builder": "^5.6",
        "tightenco/ziggy": "^2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^10.5",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.2.30"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
