# =============================================================================
# Hotelesy Desktop — environment template
# =============================================================================
# Copy to .env when building / running the desktop installer:
#   cp .env.desktop.example .env
#
# The desktop build is single-tenant, offline-first, license-gated.
# It does NOT need APP_URL (NativePHP runs on a local random port) or any
# Razorpay / cloud-secrets configuration.
# =============================================================================

APP_NAME=Hotelesy
APP_ENV=production
APP_DEBUG=false
APP_KEY=                                # generate with: php artisan key:generate
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_URL=http://localhost

# ---- Mode flag ----------------------------------------------------------
# desktop = single-tenant offline build with license activation.
# Anything else = SaaS cloud build. The DesktopServiceProvider only loads
# when this is set to "desktop".
APP_MODE=desktop

# ---- Database (SQLite shipped inside the installer) ---------------------
DB_CONNECTION=sqlite
DB_DATABASE=storage/app/desktop/hotelesy.sqlite

# ---- Sessions / cache (file-based — no Redis dependency) ----------------
SESSION_DRIVER=file
SESSION_LIFETIME=43200
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

# ---- Logging ------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=warning

# ---- Desktop license server ---------------------------------------------
# This is the cloud Hotelesy URL the desktop talks to during activation
# and periodic phone-home re-validation.
DESKTOP_LICENSE_SERVER=https://hotelesy.com/api/desktop

# Phone-home cadence (in days). Anything ≥ 30d offline → soft-warn banner.
# ≥ 60d offline → read-only mode until a successful re-validation.
DESKTOP_PHONE_HOME_DAYS=7
DESKTOP_SOFT_WARN_DAYS=30
DESKTOP_LOCK_READONLY_DAYS=60

# ---- Single-tenant binding ---------------------------------------------
# The first-run setup wizard creates these on the customer's machine.
DESKTOP_TENANT_ID=1
DESKTOP_PROPERTY_ID=1

# ---- Optional: cloud sync ----------------------------------------------
# When true, periodically pushes a redacted backup snapshot to the cloud
# account the activation key was issued under. Lets a hotelier switch
# between cloud and desktop editions without losing data.
DESKTOP_CLOUD_SYNC=false

# ---- Mail (disabled by default; offline build has no SMTP) -------------
MAIL_MAILER=log

# ---- Misc --------------------------------------------------------------
BCRYPT_ROUNDS=10
