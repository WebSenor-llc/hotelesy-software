APP_NAME="Miraj Hotel Suite"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://miraj.test
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=miraj_hotel_suite
DB_USERNAME=root
DB_PASSWORD=

# Multi-tenant SaaS configuration
TENANT_RESOLUTION=subdomain
# Options: subdomain (mirajhotels.app.com), header (X-Tenant-ID), session
CENTRAL_DOMAIN=miraj-app.test

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@miraj-hotel.com"
MAIL_FROM_NAME="${APP_NAME}"

# Channel Manager - AxisRooms
AXISROOMS_BASE_URL=https://api.axisrooms.com/api
AXISROOMS_USERNAME=
AXISROOMS_PASSWORD=
AXISROOMS_HOTEL_ID=
AXISROOMS_TIMEOUT=30

# Channel Manager - STAAH (alternative driver)
STAAH_BASE_URL=https://connect.staah.net
STAAH_API_KEY=

# Channel Manager - SiteMinder (alternative driver)
SITEMINDER_BASE_URL=
SITEMINDER_USERNAME=
SITEMINDER_PASSWORD=

# Default channel manager driver per tenant (overridable in DB)
CHANNEL_MANAGER_DRIVER=axisrooms

# Payment Gateway (Razorpay - India default)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# ID of the Razorpay subscription plan for ₹999/mo recurring auto-charge
RAZORPAY_MONTHLY_PLAN_ID=
# Trial mandate verification charge (in paise — 100 = ₹1)
RAZORPAY_MANDATE_AMOUNT=100
# Default monthly retail price (in paise — 99900 = ₹999)
RAZORPAY_MONTHLY_PRICE=99900
# Days of free trial before first auto-charge
RAZORPAY_TRIAL_DAYS=30
# When true (and keys empty), payment flows go through stub mode for dev
RAZORPAY_TEST_MODE=true

# WhatsApp - AiSensy (Piyush already uses this)
AISENSY_API_KEY=
AISENSY_API_URL=https://backend.aisensy.com/campaign/t1/api/v2

# SMS Gateway
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MIRAJH

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,miraj-app.test,*.miraj-app.test

# Feature flags
FEATURE_OFFLINE_SYNC=true
FEATURE_CHANNEL_MANAGER=true
FEATURE_BOOKING_ENGINE=false
FEATURE_NIGHT_AUDIT=true

# Night audit defaults
NIGHT_AUDIT_CUTOFF_TIME=02:00
NIGHT_AUDIT_AUTO_RUN=false
